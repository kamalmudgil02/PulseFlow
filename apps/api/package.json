    "@pulseflow/shared": "workspace:*",
    "dotenv": "^16.0.0",
    "ioredis": "6.0.0",
    "pg": "8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
