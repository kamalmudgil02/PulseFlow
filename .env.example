# PulseFlow Environment Configuration Example
# Copy to .env and configure for your local environment

# Application Service URLs (for reference):
# - Web Application: http://localhost:3001
# - API Application: http://localhost:4000
# - Worker Health: http://localhost:4001

# Node environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# API Application Configuration
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL=postgresql://pulseflow:pulseflow@localhost:5432/pulseflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT (not yet used in MVP)
JWT_SECRET=local-development-secret-minimum-32-characters-required-here

# Web Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Worker Application Configuration
WORKER_CONCURRENCY=10
