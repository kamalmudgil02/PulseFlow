// once the database design document receives explicit approval.
//
// Prisma 7 requirement: the datasource block does NOT contain a url field.
// The connection URL is configured in prisma.config.ts under datasource.url.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
